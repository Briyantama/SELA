# Copy to .env for local development. Never commit .env.
# Placeholder values only; use your own local-only values.
POSTGRES_USER=sela
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sela
REDIS_PASSWORD=change-me-local-only

# API settings (apps/api, internal/config). Keep the values consistent with the entries above.
DATABASE_URL=postgres://sela:change-me-local-only@127.0.0.1:5432/sela?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
# Mailpit from deploy/docker-compose.yml: SMTP on 1025, inbox UI at http://127.0.0.1:8025
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=no-reply@sela.local
# Generate your own, at least 32 characters, e.g.: openssl rand -hex 32
OTP_HMAC_KEY=
# Plain-HTTP local development only; keep true (the default) anywhere else.
COOKIE_SECURE=false
# Optional: PORT (default 8080), GRPC_PORT (default 9090), SMTP_USERNAME, SMTP_PASSWORD
